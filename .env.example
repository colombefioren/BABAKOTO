# Babakoto configuration. Copy to .env and fill in. NEVER commit .env.
# Every variable is documented here; services fail at startup with a clear
# message if a required variable for the selected providers is missing.

# --- General ---
# Log verbosity for every service: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Provider selection ---
# STT provider: sunflower (self-hosted, default) | gladia (cloud) | babakoto-asr (Milestone 2)
STT_PROVIDER=sunflower
# TTS provider: omnivoice (self-hosted) | mms (dev-only, NON-COMMERCIAL) | babakoto-tts (Milestone 3)
TTS_PROVIDER=omnivoice
# Must be "true" to allow non-commercial assets (mms, possibly omnivoice weights).
# Off by default. A startup warning is printed when on. Never use in production.
ALLOW_NON_COMMERCIAL_ASSETS=false

# --- LLM ---
# anthropic | openai | google | openai-compatible
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Only for LLM_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=

# --- STT ---
# Hugging Face token (gated datasets/models, e.g. AfriVoice)
HF_TOKEN=
# Pinned model revision (commit hash), not just the name
SUNFLOWER_MODEL_REVISION=
# Only for STT_PROVIDER=gladia
GLADIA_API_KEY=

# --- TTS ---
# Reference voice clip (path on host) and its exact transcript. No clip ships in the repo.
TTS_REFERENCE_AUDIO_PATH=
TTS_REFERENCE_TEXT=
OMNIVOICE_MODEL_REVISION=

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- API / database (Milestone 3) ---
DATABASE_URL=postgresql+psycopg://babakoto:babakoto@localhost:5432/babakoto
API_SECRET_KEY=

# --- Privacy ---
# Days to keep transcripts and audio; 0 = do not store.
DATA_RETENTION_DAYS=30
# Redact phone numbers and emails from stored transcripts.
REDACT_PII=true
# Use conversations for training ONLY with explicit user opt-in consent.
ALLOW_TRAINING_ON_CONVERSATIONS=false

# --- Experiment tracking (optional) ---
MLFLOW_TRACKING_URI=
WANDB_API_KEY=
