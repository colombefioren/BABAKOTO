# Babakoto configuration. Copy to .env and fill in. NEVER commit .env.
# Every variable is documented here; services fail at startup with a clear
# message if a required variable for the selected providers is missing.

# --- General ---
# Log verbosity for every service: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Service-to-service auth (stt and tts services) ---
# Shared secret, at least 16 characters. Callers send `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
SERVICE_TOKEN=
# Local development only: allow running without SERVICE_TOKEN (the service logs a warning).
ALLOW_UNAUTHENTICATED=false

# --- Agent worker ---
STT_SERVICE_URL=http://localhost:8001
TTS_SERVICE_URL=http://localhost:8002
# Sample rate the TTS engine produces: 24000 for OmniVoice, 16000 for MMS. The agent checks it.
TTS_SAMPLE_RATE=24000
SERVICE_TIMEOUT_S=30
# Folder with default.mg.md and first_message.mg.txt (containers set this)
# PROMPTS_DIR=
# Override the system prompt or greeting with your own files
SYSTEM_PROMPT_PATH=
FIRST_MESSAGE_PATH=
# Seconds of silence before the agent answers, and the longest it waits
ENDPOINTING_MIN_DELAY_S=0.4
ENDPOINTING_MAX_DELAY_S=2.0
# Seconds of speech that count as an interruption (barge-in budget is 300 ms)
INTERRUPTION_MIN_DURATION_S=0.2
VAD_MIN_SILENCE_S=0.3

# --- Provider selection ---
# Agent STT provider: sunflower | gladia | babakoto-asr.
# Compose uses this setting for GPU and selects gladia for CPU.
STT_PROVIDER=sunflower
# TTS engine: omnivoice | mms | fake. omnivoice and mms use NON-COMMERCIAL weights and need
# ALLOW_NON_COMMERCIAL_ASSETS=true. babakoto-tts arrives in Milestone 3.
TTS_ENGINE=fake
# Must be "true" to allow non-commercial assets (mms, possibly omnivoice weights).
# Off by default. A startup warning is printed when on. Never use in production.
ALLOW_NON_COMMERCIAL_ASSETS=false

# --- LLM ---
# anthropic | openai | google | openai-compatible
LLM_PROVIDER=anthropic
# Blank uses the plugin's default model. Required for openai-compatible.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Only for LLM_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- STT ---
# Hugging Face token (gated datasets/models, e.g. AfriVoice)
HF_TOKEN=
# STT engine: sunflower | babakoto-asr | fake (fake returns canned text; tests and wiring checks only)
STT_ENGINE=sunflower
# SunflowerASR is a gated repo: accept its terms on Hugging Face with the account behind HF_TOKEN.
SUNFLOWER_MODEL_ID=Sunbird/SunflowerASR-51-african-languages
# REQUIRED. Commit hash of the model repo, so runs are reproducible. Verify it before use.
SUNFLOWER_MODEL_REVISION=
# Token id of Malagasy in the Sunflower language map (from the model card)
SUNFLOWER_LANGUAGE_TOKEN_ID=50349
SUNFLOWER_DEVICE=cuda
# Absolute path to the exported local checkpoint. Used by STT_ENGINE=babakoto-asr.
BABAKOTO_ASR_MODEL_PATH=
BABAKOTO_ASR_DEVICE=cuda
# Streaming endpoint voice detection and upload limits
MAX_AUDIO_SECONDS=60
VAD_THRESHOLD_DB=-40
VAD_SILENCE_MS=500
VAD_MIN_SPEECH_MS=200
# Only for STT_PROVIDER=gladia
GLADIA_API_KEY=

# --- TTS ---
# Reference voice clip (absolute host path) and its exact transcript. Signed consent is required.
TTS_REFERENCE_AUDIO_PATH=
TTS_REFERENCE_TEXT=
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
# REQUIRED for omnivoice. Commit hash of the model repo. Verify it before use.
OMNIVOICE_MODEL_REVISION=
OMNIVOICE_DEVICE=cuda:0
# Only for TTS_ENGINE=mms (dev only, non-commercial). Revision is required.
MMS_MODEL_ID=facebook/mms-tts-mlg
MMS_MODEL_REVISION=
MMS_DEVICE=cuda
# Longest text accepted by one TTS request, in characters
MAX_TEXT_CHARS=2000
# Longest sentence after normalization, in characters (digits expand into words)
MAX_SPOKEN_CHARS=1500
# Synthesis calls running at once; others wait
MAX_CONCURRENT_SYNTHESIS=2

# --- LiveKit ---
# Browser-facing URL. Compose sets the worker URL separately on the private network.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Playground login uses username babakoto. just dev generates a 64-character password.
WEB_PLAYGROUND_PASSWORD=
# Maximum concurrent rooms admitted by a single playground. 1 to 100.
WEB_MAX_PLAYGROUND_ROOMS=4
# Optional service URL for a standalone web process. Compose uses private Docker DNS.
# LIVEKIT_ROOM_SERVICE_URL=http://localhost:7880
# Number of trusted reverse proxies in front of the web app. 0 ignores X-Forwarded-For (safe default).
WEB_TRUSTED_PROXY_HOPS=0

# --- API / database (Milestone 3) ---
# Set DATABASE_URL for standalone API use. Compose generates its own DSN.
DATABASE_URL=
# The web server uses this value only to reach a standalone configuration API.
API_URL=http://127.0.0.1:8000
# Both values below are generated locally by just dev.
API_SECRET_KEY=
POSTGRES_PASSWORD=

# --- Privacy ---
# Days to keep transcripts and audio; 0 = do not store.
DATA_RETENTION_DAYS=30
# Redact phone numbers and emails from stored transcripts.
REDACT_PII=true
# Use conversations for training ONLY with explicit user opt-in consent.
ALLOW_TRAINING_ON_CONVERSATIONS=false

# --- Experiment tracking (optional) ---
MLFLOW_TRACKING_URI=
WANDB_API_KEY=
